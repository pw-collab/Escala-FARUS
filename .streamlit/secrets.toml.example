# Modelo dos "Secrets" do app.
#
# Local  : copie este arquivo para .streamlit/secrets.toml e preencha.
# Deploy : cole o mesmo conteúdo em Streamlit Community Cloud
#          (Manage app -> Settings -> Secrets).
#
# ATENÇÃO: .streamlit/secrets.toml está no .gitignore. Nunca versione a chave.

[app]
# Senha compartilhada da equipe. Se ficar em branco/ausente, o app abre sem senha.
senha = "troque-esta-senha"

[planilha]
# Use UM dos dois. O id é o trecho entre /d/ e /edit na URL da planilha.
id = "1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890"
# url = "https://docs.google.com/spreadsheets/d/1AbCd.../edit"

# Conteúdo do JSON da Service Account do Google Cloud.
# Copie campo a campo do arquivo baixado. A private_key precisa das quebras
# de linha escritas como \n dentro das aspas triplas.
[gcp_service_account]
type = "service_account"
project_id = "seu-projeto"
private_key_id = "..."
private_key = """-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"""
client_email = "escala-app@seu-projeto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
